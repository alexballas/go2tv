{
  "name": "go2tv-webui",
  "private": true,
  "type": "module",
  "description": "Build tooling and tests for the Go2TV Web UI",
  "scripts": {
    "build:webui:css": "tailwindcss -i internal/webui/src/app.css -o internal/webui/dist/app.css --minify",
    "build:webui:js": "esbuild internal/webui/src/app.js --bundle --format=esm --minify --outfile=internal/webui/dist/app.js",
    "build:webui": "npm run build:webui:css && npm run build:webui:js && node scripts/build-webui.mjs",
    "format:webui": "prettier --write internal/webui/src scripts/build-webui.mjs package.json",
    "test": "npm run test:webui",
    "test:webui": "node --test internal/webui/src/client.test.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "esbuild": "^0.25.10",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14"
  },
  "dependencies": {
    "@openai/codex": "^0.144.6"
  }
}
